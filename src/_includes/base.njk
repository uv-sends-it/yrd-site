<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ seoTitle or (title + " — " + site.clubName) }}</title>
  <meta name="description" content="{{ description or site.tagline }}">
  <meta name="robots" content="index, follow, max-image-preview:large">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.clubName }}">
  <meta property="og:locale" content="en_AU">
  <meta property="og:title" content="{{ seoTitle or (title + " — " + site.clubName) }}">
  <meta property="og:description" content="{{ description or site.tagline }}">
  <meta property="og:url" content="{{ site.canonicalUrl }}{{ page.url }}">
  <meta property="og:image" content="{{ site.canonicalUrl }}/assets/photo-hero-4.jpg">
  <meta property="og:image:alt" content="Yarra River Dragons team paddling together in Melbourne">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ seoTitle or (title + " — " + site.clubName) }}">
  <meta name="twitter:description" content="{{ description or site.tagline }}">
  <meta name="twitter:image" content="{{ site.canonicalUrl }}/assets/photo-hero-4.jpg">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": ["Organization", "SportsOrganization"],
        "@id": "{{ site.canonicalUrl }}/#organization",
        "name": "{{ site.clubName }}",
        "url": "{{ site.canonicalUrl }}/",
        "logo": "{{ site.canonicalUrl }}/assets/yrd-logo.png",
        "image": "{{ site.canonicalUrl }}/assets/photo-hero-4.jpg",
        "email": "{{ site.email }}",
        "sameAs": ["https://www.instagram.com/{{ site.instagramHandle }}/"],
        "location": {
          "@type": "Place",
          "name": "Community Boating Hub",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "912 Collins Street",
            "addressLocality": "Docklands",
            "addressRegion": "VIC",
            "postalCode": "3008",
            "addressCountry": "AU"
          }
        }
      },
      {
        "@type": "WebPage",
        "@id": "{{ site.canonicalUrl }}{{ page.url }}#webpage",
        "url": "{{ site.canonicalUrl }}{{ page.url }}",
        "name": "{{ seoTitle or (title + " — " + site.clubName) }}",
        "description": "{{ description or site.tagline }}",
        "primaryImageOfPage": {
          "@type": "ImageObject",
          "url": "{{ site.canonicalUrl }}/assets/photo-hero-4.jpg"
        },
        "isPartOf": { "@id": "{{ site.canonicalUrl }}/#website" }
      },
      {
        "@type": "WebSite",
        "@id": "{{ site.canonicalUrl }}/#website",
        "name": "{{ site.clubName }}",
        "url": "{{ site.canonicalUrl }}/",
        "publisher": { "@id": "{{ site.canonicalUrl }}/#organization" }
      }
    ]
  }
  </script>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any">
  <meta name="theme-color" content="#af1b23">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <link rel="canonical" href="{{ site.canonicalUrl }}{{ page.url }}">
  <link rel="alternate" type="text/calendar" title="{{ site.clubName }} public events" href="{{ site.calendarPublicFeedUrl }}">
  {% if site.umamiWebsiteId %}
  <script defer src="{{ site.umamiScriptUrl }}" data-website-id="{{ site.umamiWebsiteId }}"></script>
  {% endif %}
  <link rel="stylesheet" href="{{ '/css/main.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/chat.css' | url }}">
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  {% include "nav.njk" %}
  {% include "ticker.njk" %}
  <script>
    (function () {
      var toggle = document.querySelector(".nav__toggle");
      var links = document.getElementById("nav-links");
      if (!toggle || !links) return;

      function closeMenu(returnFocus) {
        links.classList.remove("is-open");
        toggle.setAttribute("aria-expanded", "false");
        if (returnFocus) toggle.focus();
      }

      toggle.addEventListener("click", function () {
        var open = links.classList.toggle("is-open");
        toggle.setAttribute("aria-expanded", open ? "true" : "false");
      });

      links.addEventListener("click", function (event) {
        if (event.target.closest("a")) closeMenu(false);
      });

      document.addEventListener("keydown", function (event) {
        if (event.key === "Escape" && links.classList.contains("is-open")) {
          closeMenu(true);
        }
      });
    })();
  </script>
  <main id="main-content">
    {{ content | safe }}
  </main>
  <a class="mobile-join-cta" href="{{ site.dragonPassUrl }}" target="_blank" rel="noopener" data-mobile-join-cta>
    <span>Try dragon boating free</span>
    <span aria-hidden="true">&rarr;</span>
  </a>
  {% include "chat.njk" %}
  {% include "footer.njk" %}
  <script>
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });
      document.querySelectorAll(".reveal").forEach(function (el) {
        var rect = el.getBoundingClientRect();
        if (rect.top < window.innerHeight) {
          el.classList.add("is-visible");
        } else {
          observer.observe(el);
        }
      });
    } else {
      document.querySelectorAll(".reveal").forEach(function (el) {
        el.classList.add("is-visible");
      });
    }

    var mobileJoinCta = document.querySelector("[data-mobile-join-cta]");
    var hero = document.querySelector(".hero");
    if (mobileJoinCta && hero && "IntersectionObserver" in window) {
      var heroObserver = new IntersectionObserver(function (entries) {
        mobileJoinCta.classList.toggle("is-visible", !entries[0].isIntersecting);
      }, { threshold: 0 });
      heroObserver.observe(hero);
    }

    var strokeEls = document.querySelectorAll("[data-stroke-rate]");
    if (strokeEls.length && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      setInterval(function () {
        var spm = 60 + Math.round(Math.random() * 12);
        strokeEls.forEach(function (el) { el.textContent = spm; });
      }, 1600);
    }
  </script>
  <script src="{{ '/assets/analytics.js' | url }}"></script>
  <script type="module" src="{{ '/assets/chat.js' | url }}"></script>
</body>
</html>
