<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' https://cloud.umami.is https://www.instagram.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.instagram.com; connect-src 'self' https://cloud.umami.is https://api.umami.is https://formsubmit.co; frame-src https://www.google.com https://www.instagram.com; form-action 'self' https://formsubmit.co; upgrade-insecure-requests">
  <title>{{ title }} | {{ site.clubName }}</title>
  <meta name="description" content="{{ description or site.tagline }}">
  <link rel="canonical" href="{{ site.canonicalUrl }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ title }} | {{ site.clubName }}">
  <meta property="og:description" content="{{ description or site.tagline }}">
  <meta property="og:image" content="{{ site.canonicalUrl }}/assets/photo-hero-4.jpg">
  <meta property="og:image:alt" content="Yarra River Dragons paddling together on the Yarra">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="alternate" type="text/calendar" title="YRD public calendar" href="{{ site.calendarPublicFeedUrl }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {% if site.umamiWebsiteId %}
  <script defer src="{{ site.umamiScriptUrl }}" data-website-id="{{ site.umamiWebsiteId }}"></script>
  {% endif %}
  <link rel="stylesheet" href="{{ '/css/main.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/chat.css' | url }}">
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  {% include "nav.njk" %}
  <main id="main-content">{{ content | safe }}</main>
  <a class="mobile-join-cta" href="{{ '/join/' | url }}" data-mobile-join-cta>
    <span>Come &amp; try for free</span><span aria-hidden="true">→</span>
  </a>
  {% include "chat.njk" %}
  {% include "footer.njk" %}
  <script src="{{ '/assets/site.js' | url }}" defer></script>
  <script src="{{ '/assets/analytics.js' | url }}" defer></script>
  <script type="module" src="{{ '/assets/chat.js' | url }}"></script>
</body>
</html>
