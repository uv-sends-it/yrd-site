<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — {{ site.clubName }}</title>
  <meta name="description" content="{{ site.tagline }}">
  <link rel="alternate" type="text/calendar" title="{{ site.clubName }} public events" href="{{ site.calendarPublicFeedUrl }}">
  <link rel="stylesheet" href="{{ '/css/main.css' | url }}">
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  {% include "nav.njk" %}
  {% include "ticker.njk" %}
  <script>
    (function () {
      var toggle = document.querySelector(".nav__toggle");
      var links = document.getElementById("nav-links");
      if (!toggle || !links) return;

      function closeMenu(returnFocus) {
        links.classList.remove("is-open");
        toggle.setAttribute("aria-expanded", "false");
        if (returnFocus) toggle.focus();
      }

      toggle.addEventListener("click", function () {
        var open = links.classList.toggle("is-open");
        toggle.setAttribute("aria-expanded", open ? "true" : "false");
      });

      links.addEventListener("click", function (event) {
        if (event.target.closest("a")) closeMenu(false);
      });

      document.addEventListener("keydown", function (event) {
        if (event.key === "Escape" && links.classList.contains("is-open")) {
          closeMenu(true);
        }
      });
    })();
  </script>
  <main id="main-content">
    {{ content | safe }}
  </main>
  <a class="mobile-join-cta" href="{{ site.dragonPassUrl }}" target="_blank" rel="noopener" data-mobile-join-cta>
    <span>Try dragon boating free</span>
    <span aria-hidden="true">&rarr;</span>
  </a>
  {% include "footer.njk" %}
  <script>
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });
      document.querySelectorAll(".reveal").forEach(function (el) {
        // Content already in the initial viewport shows immediately — only
        // below-the-fold content waits for the scroll-triggered reveal.
        var rect = el.getBoundingClientRect();
        if (rect.top < window.innerHeight) {
          el.classList.add("is-visible");
        } else {
          observer.observe(el);
        }
      });
    } else {
      document.querySelectorAll(".reveal").forEach(function (el) {
        el.classList.add("is-visible");
      });
    }

    var mobileJoinCta = document.querySelector("[data-mobile-join-cta]");
    var hero = document.querySelector(".hero");
    if (mobileJoinCta && hero && "IntersectionObserver" in window) {
      var heroObserver = new IntersectionObserver(function (entries) {
        mobileJoinCta.classList.toggle("is-visible", !entries[0].isIntersecting);
      }, { threshold: 0 });
      heroObserver.observe(hero);
    }

    // Signature detail: stroke-rate readout drifts within a real racing range (60-72 SPM).
    var strokeEls = document.querySelectorAll("[data-stroke-rate]");
    if (strokeEls.length && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      setInterval(function () {
        var spm = 60 + Math.round(Math.random() * 12);
        strokeEls.forEach(function (el) { el.textContent = spm; });
      }, 1600);
    }
  </script>
</body>
</html>
