<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — {{ site.clubName }}</title>
  <meta name="description" content="{{ site.tagline }}">
  <link rel="stylesheet" href="{{ '/css/main.css' | url }}">
</head>
<body>
  {% include "nav.njk" %}
  {% include "ticker.njk" %}
  <script>
    (function () {
      var toggle = document.querySelector(".nav__toggle");
      var links = document.getElementById("nav-links");
      toggle.addEventListener("click", function () {
        var open = links.classList.toggle("is-open");
        toggle.setAttribute("aria-expanded", open);
      });
    })();
  </script>
  <main>
    {{ content | safe }}
  </main>
  {% include "footer.njk" %}
  <script>
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });
      document.querySelectorAll(".reveal").forEach(function (el) {
        // Content already in the initial viewport shows immediately — only
        // below-the-fold content waits for the scroll-triggered reveal.
        var rect = el.getBoundingClientRect();
        if (rect.top < window.innerHeight) {
          el.classList.add("is-visible");
        } else {
          observer.observe(el);
        }
      });
    } else {
      document.querySelectorAll(".reveal").forEach(function (el) {
        el.classList.add("is-visible");
      });
    }

    // Signature detail: stroke-rate readout drifts within a real racing range (60-72 SPM).
    var strokeEls = document.querySelectorAll("[data-stroke-rate]");
    if (strokeEls.length && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      setInterval(function () {
        var spm = 60 + Math.round(Math.random() * 12);
        strokeEls.forEach(function (el) { el.textContent = spm; });
      }, 1600);
    }
  </script>
</body>
</html>
