{% import "icon.njk" as ic %}
<header class="site-header">
  <nav class="nav" aria-label="Main navigation">
    <div class="container nav__bar">
      <a class="nav__brand" href="{{ '/' | url }}" aria-label="Yarra River Dragons home"><img src="{{ '/assets/yrd-logo.png' | url }}" alt="Yarra River Dragons" width="142" height="65"></a>
      <span class="nav__home-label">Melbourne, on the Yarra</span>
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Menu">
        <span class="icon-open">{{ ic.icon("menu-2",24) }}</span><span class="icon-close">{{ ic.icon("x",24) }}</span>
      </button>
      <ul class="nav__links" id="nav-links">
        <li><a href="{{ '/' | url }}" {% if page.url == "/" %}aria-current="page"{% endif %}>Home</a></li>
        <li><a href="{{ '/about/' | url }}" {% if page.url == "/about/" %}aria-current="page"{% endif %}>Our crew</a></li>
        <li><a href="{{ '/gallery/' | url }}" {% if page.url == "/gallery/" %}aria-current="page"{% endif %}>Moments on the water</a></li>
        <li><a class="nav__join" href="{{ '/join/' | url }}" {% if page.url == "/join/" %}aria-current="page"{% endif %}>Come &amp; try</a></li>
      </ul>
    </div>
  </nav>
</header>
