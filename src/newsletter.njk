---
title: Newsletter
layout: base.njk
permalink: /newsletter/
---
<section class="hero hero--plain">
  <div class="hero__inner">
    <span class="eyebrow mono-label">Archive</span>
    <h1 class="hero__title">Newsletter</h1>
    <p class="hero__lead">
      Race results and the calendar live inside each issue below &mdash; that's deliberate for now,
      not a missing feature.
    </p>
  </div>
</section>

<section class="section">
  <div class="container">
    {% if newsletters.length %}
      {% set currentYear = "" %}
      {% for n in newsletters %}
        {% if n.year != currentYear %}
          {% if not loop.first %}</ul>{% endif %}
          <div class="divider mono-label">{{ n.year }}</div>
          <ul>
          {% set currentYear = n.year %}
        {% endif %}
        <li><a href="{{ n.url }}">{{ n.month }}/{{ n.year }} newsletter</a></li>
        {% if loop.last %}</ul>{% endif %}
      {% endfor %}
    {% else %}
      <p>Newsletter archive coming soon &mdash; committee adds issues directly to this folder.</p>
    {% endif %}
  </div>
</section>
