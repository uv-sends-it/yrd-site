---
title: Home
layout: base.njk
---
{% import "cta-dragonpass.njk" as cta %}
{% import "photo-card.njk" as photo %}
{% import "icon.njk" as ic %}

<section class="hero" style="background-image: url('{{ '/assets/photo-hero-4.jpg' | url }}');">
  <div class="hero__inner">
    <span class="eyebrow mono-label">{{ ic.icon("activity", 16) }} Open trial &mdash; first month free</span>
    <h1 class="hero__title">Paddle the Yarra.</h1>
    <span class="brush">Train as one crew.</span>
    <p class="hero__lead">
      {{ site.bridgeLine }}
      {% if site.tagline.startsWith("TODO") %}<span class="placeholder-tag">content coming soon</span>{% endif %}
    </p>
    <div class="hero__ctas">
      {{ cta.ctaDragonPass(null, site.dragonPassUrl) }}
      <a class="btn btn--ghost" href="{{ '/join/' | url }}">See a session</a>
    </div>
  </div>
</section>


<section class="section section--surface" aria-labelledby="who-is-it-for">
  <div class="container">
    <div class="divider mono-label">{{ ic.icon("heart", 16) }} Who is it for?</div>
    <div style="max-width: 780px;">
      <h2 id="who-is-it-for">Come as you are. There's a place for you in the crew.</h2>
      <p>Dragon boating is for people of all ages, abilities, genders, identities, cultures and backgrounds. Aboriginal and Torres Strait Islander people, and people who may need extra support to participate, are warmly welcome at Yarra River Dragons.</p>
      <p>Everyone was new once. You don't need experience to come and try. If you have questions, accessibility needs or would like some help getting started, have a chat with us. We'll listen and work with you on reasonable adjustments or support where we can.</p>
      <p><strong>Worried about the cost?</strong> Financial support may be available. You're welcome to contact us for a confidential conversation about your circumstances.</p>
      <div class="hero__ctas" style="margin-top: var(--space-4);">
        <a class="btn btn--primary" href="{{ '/join/' | url }}">Come and try {{ ic.icon("arrow-right", 16) }}</a>
        <a class="btn btn--ghost" href="mailto:{{ site.email }}?subject=Chat%20about%20joining%20YRD">Have a chat with us {{ ic.icon("mail", 16) }}</a>
      </div>
    </div>
  </div>
</section>

<div class="readout">
  <div class="readout__item">
    {{ ic.icon("activity", 28) }}
    <span>
      <span class="readout__value"><span data-stroke-rate>64</span><span class="unit">SPM</span></span>
      <span class="readout__label">Current stroke rate</span>
    </span>
  </div>
  <div class="readout__item">
    {{ ic.icon("calendar-event", 28) }}
    <span>
      <span class="readout__value">1 month</span>
      <span class="readout__label">Free trial</span>
    </span>
  </div>
  <div class="readout__item">
    {{ ic.icon("sailboat", 28) }}
    <span>
      <span class="readout__value">2016</span>
      <span class="readout__label">On the water since</span>
    </span>
  </div>
</div>

<section class="section section--surface">
  <div class="glow-field"></div>
  <div class="container card-grid home-grid">
    <div class="card reveal">
      {{ ic.icon("clock", 22) }}
      <span class="mono-label" style="color: var(--red); display: block; margin-top: var(--space-2)">Next session</span>
      {% set next = schedule.sessions[0] %}
      {% if next.cancelled %}
      <h3>Session cancelled</h3>
      <p>Check TeamApp or Facebook for the latest update.</p>
      {% else %}
      <h3>{{ next.day }} &middot; {{ next.time }}</h3>
      <p>{{ next.notes }}</p>
      {% endif %}
    </div>
    <div class="card reveal">
      {{ ic.icon("map-pin", 22) }}
      <span class="mono-label" style="color: var(--red); display: block; margin-top: var(--space-2)">Where we paddle</span>
      <h3>Community Boating Hub</h3>
      <p>912 Collins Street, Docklands.</p>
      <p><a href="{{ site.mapsUrl }}" target="_blank" rel="noopener noreferrer" aria-label="View directions to Community Boating Hub in Google Maps">Get directions {{ ic.icon("arrow-right", 16) }}</a></p>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="divider mono-label">{{ ic.icon("users", 16) }} Life on the water</div>
    <div class="photo-cluster">
      {{ photo.photoCard("photo-card--1", "/assets/photo-hero-2.jpg") }}
      {{ photo.photoCard("photo-card--2", "/assets/photo-about.jpg") }}
      {{ photo.photoCard("photo-card--3", "/assets/photo-hero-4.jpg") }}
    </div>
    <p><a href="{{ '/gallery/' | url }}">See more on Instagram {{ ic.icon("arrow-right", 16) }}</a></p>
  </div>
</section>
