---
title: Join Us
layout: base.njk
permalink: /join/
---
{% import "cta-dragonpass.njk" as cta %}

<section class="hero" style="background-image: url('{{ '/assets/photo-hero-2.jpg' | url }}');">
  <div class="hero__inner">
    <span class="eyebrow mono-label">Come and try</span>
    <h1 class="hero__title">Your first session is</h1>
    <span class="brush">free.</span>
    <p class="hero__lead">
      No boat, no paddle, no experience &mdash; just show up. A Dragon Pass gets you a full month
      of training with the club before you decide whether to join. Wear clothes you can move
      and get wet in, bring a water bottle and a towel; we supply the boat, paddles, and PFDs.
    </p>
    <div class="hero__ctas">
      {{ cta.ctaDragonPass("Get your Dragon Pass", site.dragonPassUrl) }}
    </div>
  </div>
</section>

<section class="section section--surface">
  <div class="container">
    <div class="divider mono-label">Where we train</div>
    <p>{{ site.location }}
      {% if site.location.includes("TODO") %}<span class="placeholder-tag">content coming soon</span>{% endif %}
    </p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="divider mono-label">Training schedule</div>
    <table>
      <thead>
        <tr><th>Day</th><th>Time</th><th>Notes</th></tr>
      </thead>
      <tbody>
        {% for s in schedule.sessions %}
        <tr>
          <td>{{ s.day }}</td>
          <td>{{ s.time }}</td>
          <td>{{ s.notes }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    <span class="placeholder-tag">content coming soon</span>
  </div>
</section>

<section class="section section--surface">
  <div class="container">
    <div class="divider mono-label">Resources</div>
    <div class="card-grid">
      <div class="card reveal">
        <h3>Paddling technique</h3>
        <p>TODO: refresh technique guide from current site's Resources page.</p>
        <span class="placeholder-tag">content coming soon</span>
      </div>
      <div class="card reveal">
        <h3>What gear to bring</h3>
        <p>TODO: refresh gear guide from current site's Resources page.</p>
        <span class="placeholder-tag">content coming soon</span>
      </div>
    </div>
  </div>
</section>

<section class="section section--dark">
  <div class="container">
    <h2>Already a member?</h2>
    <p>Head to TeamApp for schedules, crew lists, and club communication.</p>
    <a class="btn btn--ghost" href="{{ site.teamAppUrl }}" target="_blank" rel="noopener">Open TeamApp</a>
  </div>
</section>
