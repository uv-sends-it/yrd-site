{% import "icon.njk" as ic %}
<section class="hero" style="background-image: url('{{ '/assets/photo-hero-2.jpg' | url }}');">
  <div class="hero__inner">
    <span class="eyebrow mono-label">Your YRD journey</span>
    <h1 class="hero__title">Keep paddling.</h1>
    <span class="brush">Stay with the crew.</span>
    <p class="hero__lead">Finishing your Dragon Pass or just joined? You're in the right place. Here's what happens next.</p>
    <div class="hero__ctas">
      <a class="btn btn--primary" href="#dragon-pass">Finishing my Dragon Pass {{ ic.icon("arrow-right", 16) }}</a>
      <a class="btn btn--ghost" href="#new-member">I've already joined {{ ic.icon("arrow-right", 16) }}</a>
    </div>
  </div>
</section>

<section class="section section--surface" id="dragon-pass">
  <div class="container">
    <div class="divider mono-label">{{ ic.icon("sailboat", 16) }} Your journey</div>
    <h2>From your first paddle to the crew.</h2>
    <p style="max-width:620px">Four simple steps. Already a member? Jump straight to step 3.</p>
    <ol style="list-style:none; padding:0; margin:2rem 0; display:grid; gap:1rem">
      <li style="display:grid; grid-template-columns:64px minmax(0,1fr); gap:1rem; align-items:start; position:relative">
        <div style="background:#b21f2d; color:#fff; border-radius:18px; min-height:64px; display:grid; place-items:center; font-size:1.75rem" aria-hidden="true">🚣</div>
        <div style="background:var(--surface,#fff); border:1px solid var(--border,#ddd); border-radius:18px; padding:1.25rem">
          <span class="mono-label" style="color:var(--red)">01 · Try it free</span>
          <h3 style="margin:.35rem 0">Your Dragon Pass</h3>
          <p>Enjoy a month on the water. Meet the crew and see if dragon boating is for you.</p>
          <a href="{{ '/join/' | url }}">How the free trial works {{ ic.icon("arrow-right",16) }}</a>
        </div>
      </li>
      <li style="display:grid; grid-template-columns:64px minmax(0,1fr); gap:1rem; align-items:start">
        <div style="background:#b21f2d; color:#fff; border-radius:18px; min-height:64px; display:grid; place-items:center; font-size:1.75rem" aria-hidden="true">❤️</div>
        <div style="background:var(--surface,#fff); border:1px solid var(--border,#ddd); border-radius:18px; padding:1.25rem">
          <span class="mono-label" style="color:var(--red)">02 · Stay with us</span>
          <h3 style="margin:.35rem 0">Become a member</h3>
          <p>Had fun? Choose your membership and register online. You'll see the options and fees before signing up.</p>
          <a class="btn btn--primary" href="{{ site.dragonPassUrl }}" target="_blank" rel="noopener noreferrer">Explore membership options {{ ic.icon("arrow-right",16) }}</a>
        </div>
      </li>
      <li id="new-member" style="display:grid; grid-template-columns:64px minmax(0,1fr); gap:1rem; align-items:start">
        <div style="background:#b21f2d; color:#fff; border-radius:18px; min-height:64px; display:grid; place-items:center; font-size:1.75rem" aria-hidden="true">📱</div>
        <div style="background:var(--surface,#fff); border:1px solid var(--border,#ddd); border-radius:18px; padding:1.25rem">
          <span class="mono-label" style="color:var(--red)">03 · Get connected</span>
          <h3 style="margin:.35rem 0">Join the club channels</h3>
          <div style="display:grid; gap:.8rem; margin-top:1rem">
            <div style="display:flex; gap:.75rem; align-items:start"><span aria-hidden="true" style="width:28px;height:28px;flex:0 0 28px;border-radius:8px;background:#b21f2d;color:#fff;display:grid;place-items:center;font-weight:800;font-size:15px;letter-spacing:-.06em">TA</span><div><strong>TeamApp</strong><p style="margin:.15rem 0">Join <a href="{{ site.teamAppUrl }}" target="_blank" rel="noopener noreferrer">YRD on TeamApp</a> and request the Paddlers group after paid registration.</p></div></div>
            <div style="display:flex; gap:.75rem; align-items:start"><span aria-hidden="true">✉️</span><div><strong>Your inbox</strong><p style="margin:.15rem 0">Look out for regatta plans and club news at your registered email address.</p></div></div>
            <div style="display:flex; gap:.75rem; align-items:start"><span aria-hidden="true" style="width:28px;height:28px;flex:0 0 28px;display:block"><svg width="28" height="28" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="11" fill="#b21f2d"/><path fill="#fff" d="M13.6 20v-7h2.3l.35-2.75H13.6V8.5c0-.8.22-1.34 1.35-1.34h1.44V4.7a19 19 0 0 0-2.1-.11c-2.08 0-3.5 1.27-3.5 3.6v2.06H8.45V13h2.34v7z"/></svg></span><div><strong>Facebook group</strong><p style="margin:.15rem 0">Join the <a href="https://www.facebook.com/share/1Fw7mLLMQN/" target="_blank" rel="noopener noreferrer">YRD Facebook group</a> for crew moments and updates.</p></div></div>
          </div>
        </div>
      </li>
      <li style="display:grid; grid-template-columns:64px minmax(0,1fr); gap:1rem; align-items:start">
        <div style="background:#b21f2d; color:#fff; border-radius:18px; min-height:64px; display:grid; place-items:center; font-size:1.75rem" aria-hidden="true">📅</div>
        <div style="background:var(--surface,#fff); border:1px solid var(--border,#ddd); border-radius:18px; padding:1.25rem">
          <span class="mono-label" style="color:var(--red)">04 · Paddle together</span>
          <h3 style="margin:.35rem 0">RSVP and show up</h3>
          <p>Once approved, RSVP to training and club events in TeamApp. You're part of the crew!</p>
          <a href="{{ site.teamAppUrl }}" target="_blank" rel="noopener noreferrer">Open TeamApp {{ ic.icon("arrow-right",16) }}</a>
        </div>
      </li>
    </ol>
    <div style="border-left:4px solid var(--red); padding:.8rem 1rem; background:var(--surface,#fff); border-radius:0 12px 12px 0">
      <strong>Still on your Dragon Pass?</strong> Your newbie support mentor can help confirm your seat at training. Paddlers group access comes after paid registration.
    </div>
    <p style="margin-top:1rem">Questions or need financial support? <a href="mailto:newmembers@yarrariverdragons.com.au">Email our new member team</a> privately.</p>
  </div>
</section>

