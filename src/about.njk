---
title: About
layout: base.njk
permalink: /about/
---
{% import "icon.njk" as ic %}
<section class="hero" style="background-image: url('{{ '/assets/photo-about.jpg' | url }}');">
  <div class="hero__inner">
    <span class="eyebrow mono-label">{{ ic.icon("sailboat", 16) }} On the water since 2016</span>
    <h1 class="hero__title">Who we are.</h1>
    <span class="brush">One boat, one crew.</span>
    <p class="hero__lead">
      Yarra River Dragons is a Melbourne dragon boating club. We train together on the Yarra,
      welcome people new to the sport, and help each paddler find their rhythm.
    </p>
  </div>
</section>

<section class="section section--surface">
  <div class="container club-note">
    <p>
      We acknowledge the Traditional Owners of the land on which we train, the Wurundjeri
      people of the Kulin Nation, and pay our respects to Elders past and present.
    </p>
    <p>
      Yarra River Dragons is a proud LGBTQ+ inclusive club &mdash; everyone is welcome on our boats.
    </p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="divider mono-label">{{ ic.icon("users", 16) }} Crew categories</div>
    <div class="card-grid card-grid--crew">
      <div class="card reveal"><h3>Open</h3></div>
      <div class="card reveal"><h3>Mixed</h3></div>
      <div class="card reveal"><h3>Women's</h3></div>
    </div>
  </div>
</section>

<section class="section section--surface" id="committee" aria-labelledby="committee-heading">
  <div class="container">
    <div class="divider mono-label">{{ ic.icon("users", 16) }} Committee</div>
    <h2 id="committee-heading">Our committee</h2>
    <p class="people-intro">Meet the volunteers who help keep Yarra River Dragons running.</p>
    <div class="people-group">
      <h3 class="people-group__title">Office bearers</h3>
      <div class="card-grid card-grid--people">
        {% for member in committee %}
        {% if member.role != "General" %}
        <article class="card reveal person-card">
          {% if member.photo %}<img class="person-card__photo" src="{{ member.photo | url }}" alt="Portrait of {{ member.name }}" loading="lazy">{% endif %}
          <span class="mono-label person-card__role">{{ member.role }}</span>
          <h4 class="person-card__name">{{ member.name }}</h4>
        </article>
        {% endif %}
        {% endfor %}
      </div>
    </div>
    <div class="people-group">
      <h3 class="people-group__title">General committee</h3>
      <div class="card-grid card-grid--people">
        {% for member in committee %}
        {% if member.role == "General" %}
        <article class="card reveal person-card">
          {% if member.photo %}<img class="person-card__photo" src="{{ member.photo | url }}" alt="Portrait of {{ member.name }}" loading="lazy">{% endif %}
          <h4 class="person-card__name">{{ member.name }}</h4>
        </article>
        {% endif %}
        {% endfor %}
      </div>
    </div>
    <p class="people-contact">Questions for the committee? <a href="mailto:{{ site.email }}">Contact the club {{ ic.icon("arrow-right", 16) }}</a></p>
  </div>
</section>

<section class="section" id="coaches" aria-labelledby="coaches-heading">
  <div class="container">
    <div class="divider mono-label">{{ ic.icon("activity", 16) }} Coaching</div>
    <h2 id="coaches-heading">Our coaches</h2>
    <p class="people-intro">From your first paddle stroke to race day, our coaches help the crew find their rhythm.</p>
    <div class="card-grid card-grid--people">
      {% for coach in coaches %}
      <article class="card reveal person-card">
        {% if coach.photo %}<img class="person-card__photo" src="{{ coach.photo | url }}" alt="Portrait of {{ coach.name }}" loading="lazy">{% endif %}
        <span class="mono-label person-card__role">{{ coach.role }}</span>
        <h3 class="person-card__name">{{ coach.name }}</h3>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--surface">
  <div class="glow-field"></div>
  <div class="container">
    <h2>Get in touch</h2>
    <p>
      <a href="mailto:{{ site.email }}">{{ ic.icon("mail", 16) }} {{ site.email }}</a>
      {% if site.email == "TODO" %}<span class="placeholder-tag">content coming soon</span>{% endif %}
    </p>
    <p><a href="https://instagram.com/{{ site.instagramHandle }}" target="_blank" rel="noopener">{{ ic.icon("brand-instagram", 16) }} @{{ site.instagramHandle }}</a></p>
  </div>
</section>
