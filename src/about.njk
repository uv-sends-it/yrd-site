---
title: About
layout: base.njk
permalink: /about/
---
{% import "icon.njk" as ic %}
<section class="hero" style="background-image: url('{{ '/assets/photo-about.jpg' | url }}');">
  <div class="hero__inner">
    <span class="eyebrow mono-label">{{ ic.icon("sailboat", 16) }} On the water since 2016</span>
    <h1 class="hero__title">Who we are.</h1>
    <span class="brush">One boat, one crew.</span>
    <p class="hero__lead">
      Dragon boating runs on one rule: the crew moves together, or not at all.
      TODO: refresh from current site's full "Who are we" copy.
      <span class="placeholder-tag">content coming soon</span>
    </p>
  </div>
</section>

<section class="section section--surface">
  <div class="container club-note">
    <p>
      We acknowledge the Traditional Owners of the land on which we train, the Wurundjeri
      people of the Kulin Nation, and pay our respects to Elders past and present.
    </p>
    <p>
      Yarra River Dragons is a proud LGBTQ+ inclusive club &mdash; everyone is welcome on our boats.
    </p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="divider mono-label">{{ ic.icon("users", 16) }} Crew categories</div>
    <p>TODO: confirm categories <span class="placeholder-tag">content coming soon</span></p>
    <div class="card-grid card-grid--crew">
      <div class="card reveal"><h3>Open</h3></div>
      <div class="card reveal"><h3>Mixed</h3></div>
      <div class="card reveal"><h3>Women's</h3></div>
      <div class="card reveal"><h3>Masters</h3></div>
    </div>
  </div>
</section>

<section class="section section--surface">
  <div class="container">
    <div class="divider mono-label">{{ ic.icon("users", 16) }} Committee</div>
    <div class="card-grid card-grid--people">
      {% for member in committee %}
      <div class="card reveal">
        <span class="mono-label" style="color: var(--red)">{{ member.role }}</span>
        <h3>{{ member.name }}</h3>
        <a href="mailto:{{ member.email }}">{{ ic.icon("mail", 16) }} {{ member.email }}</a>
        {% if member.name == "TODO" %}<span class="placeholder-tag">content coming soon</span>{% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="divider mono-label">{{ ic.icon("trophy", 16) }} Our sponsors</div>
    <div class="card-grid card-grid--sponsors">
      {% for sponsor in sponsors %}
      <div class="card reveal">
        <h3>{{ sponsor.name }}</h3>
        {% if sponsor.website != "TODO" %}<a href="{{ sponsor.website }}" target="_blank" rel="noopener">Visit site {{ ic.icon("arrow-right", 16) }}</a>{% endif %}
        {% if sponsor.name == "TODO" %}<span class="placeholder-tag">content coming soon</span>{% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--surface">
  <div class="glow-field"></div>
  <div class="container">
    <h2>Get in touch</h2>
    <p>
      <a href="mailto:{{ site.email }}">{{ ic.icon("mail", 16) }} {{ site.email }}</a>
      {% if site.email == "TODO" %}<span class="placeholder-tag">content coming soon</span>{% endif %}
    </p>
    <p><a href="https://instagram.com/{{ site.instagramHandle }}" target="_blank" rel="noopener">{{ ic.icon("brand-instagram", 16) }} @{{ site.instagramHandle }}</a></p>
  </div>
</section>
